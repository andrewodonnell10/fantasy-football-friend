# Copy to .env and fill in.  .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Get these from https://developer.yahoo.com/apps/ after creating an app.
# See SETUP_YAHOO_APP.md for the walkthrough.

YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here

# Must match the Redirect URI registered on the Yahoo app EXACTLY.
# yahoofantasy defaults to HTTPS and ships a self-signed cert for localhost.
# If you registered http:// instead, pass --redirect-http to `yahoofantasy login`.
YAHOO_REDIRECT_URI=https://localhost:8000

# League IDs — the numeric part only (e.g. 123456), not the full league key.
# Find them with: python scripts/fetch_league.py --discover --season 2025
# 2025 supplies the draft + transactions that drive keeper eligibility.
# 2026 supplies the draft date and current settings.
LEAGUE_ID_2025=
LEAGUE_ID_2026=

# Optional data sources (Phase 3). Leave as-is to keep them off.
ENABLE_SLEEPER=true
ENABLE_ESPN=false
ENABLE_WEATHER=true

# Where the SQLite database lives.
FFL_DB_PATH=data/ffl.db
